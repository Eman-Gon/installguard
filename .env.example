# Shared tokens (generated)
INSTALLGUARD_GATE_TOKEN=
INSTALLGUARD_INTERNAL_TOKEN=
# Separate buyer/dashboard token; never reuse the internal gate token.
INSTALLGUARD_ACCESS_TOKEN=
INSTALLGUARD_PUBLIC_URL=http://127.0.0.1:4312

# Service
INSTALLGUARD_SERVICE_PORT=4311
INSTALLGUARD_SERVICE_URL=http://127.0.0.1:4311
INSTALLGUARD_DATA_DIR=./service/data
INSTALLGUARD_DEV_MODE=0
INSTALLGUARD_OFFLINE=0

# Worker (docker | local-development | daytona)
INSTALLGUARD_WORKER_MODE=docker
INSTALLGUARD_WORKER_IMAGE=installguard-worker:node22.11.0

# Backend-only remote execution; set WORKER_MODE=daytona to enable.
DAYTONA_API_KEY=
DAYTONA_SANDBOX_ID=3e96d2eb-f19e-4354-84b8-1d3658c4a02e
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_PROJECT_DIR=/home/node/installguard

# Client demo
INSTALLGUARD_DEMO_PROVIDER=http://127.0.0.1:4315

# LLM (Nebius)
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
