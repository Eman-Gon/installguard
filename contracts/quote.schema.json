{
  "$ref": "#/definitions/quote",
  "definitions": {
    "quote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string",
          "format": "uri"
        },
        "network": {
          "type": "string",
          "const": "localnet"
        },
        "asset": {
          "type": "string",
          "const": "USDC"
        },
        "paymentType": {
          "type": "string",
          "const": "fixed"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "testProfile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "id",
        "requestDigest",
        "provider",
        "network",
        "asset",
        "paymentType",
        "amount",
        "expiresAt",
        "testProfile"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
